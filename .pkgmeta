package-as: HandyNotes_LegionInstanceWorldQuests

manual-changelog:
    filename: Docs/ChangeLog.txt
    markup-type: plain
    
enable-nolib-creation: yes

externals:
    Libs-release/LibUIDropDownMenu: 
        url: https://repos.wowace.com/wow/libuidropdownmenu/trunk/LibUIDropDownMenu

move-folders:
    HandyNotes_LegionInstanceWorldQuests/Libs: HandyNotes_LegionInstanceWorldQuests/Libs-dev
    HandyNotes_LegionInstanceWorldQuests/Libs-release: HandyNotes_LegionInstanceWorldQuests/Libs
ignore:
    - Images/PSD
    - Libs-dev

