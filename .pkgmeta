package-as: HandyNotes_LegionInstanceWorldQuests

manual-changelog:
    filename: Docs/ChangeLog.txt
    markup-type: plain
    
enable-nolib-creation: yes

# configs for WowInterface
wowi-archive-previous: yes
wowi-create-changelog: no

externals:
